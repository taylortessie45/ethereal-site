# Port to listen on (hosts like Render/Railway set this automatically)
PORT=3000
# Password for /admin (username can be anything, e.g. "admin")
ADMIN_PASSWORD=change-me
# Optional: Discord webhook to receive each application as an embed
DISCORD_WEBHOOK_URL=
# Optional: application deadline (ISO 8601). After this moment the form closes and
# POST /api/apply returns 403. Include a timezone! e.g. Z (UTC) or +06:00 (Dhaka).
# Example: 48 hours from 2026-11-03 00:00 Dhaka time -> 2026-11-05T00:00:00+06:00
APPLICATIONS_CLOSE_AT=
# Optional: spam rate limit per client IP (defaults: 10 per 15 minutes)
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MIN=15
# Optional: where applications are stored (default ./applications.json)
DATA_FILE=./applications.json
